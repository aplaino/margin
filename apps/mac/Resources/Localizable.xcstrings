    "Report %@?" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναφορά του χρήστη %@;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Reportar a %@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を報告しますか?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要举报 %@ 吗？"
          }
        }
      }
    },
    "Reports go to whoever runs Margin, with your handle and theirs and the reason you give. Messages stay encrypted and aren’t included." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αναφορές πηγαίνουν σε όποιον διαχειρίζεται το Margin, μαζί με το δικό σας όνομα χρήστη, το δικό του και τον λόγο που δίνετε. Τα μηνύματα παραμένουν κρυπτογραφημένα και δεν περιλαμβάνονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los reportes llegan a quien gestiona Margin, con tu usuario, el suyo y el motivo que indiques. Los mensajes siguen cifrados y no se incluyen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告は、あなたと相手のハンドル、および入力した理由とともにMarginの運営者に送信されます。メッセージは暗号化されたままで、報告には含まれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举报会发送给 Margin 的运营方，内容包括你和对方的用户名以及你提供的理由。消息保持加密，不会包含在内。"
          }
        }
      }
    },
