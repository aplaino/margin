    },
    "Margin then tucks into the edge of your screen." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη συνέχεια, το Margin μαζεύεται στην άκρη της οθόνης σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después, Margin se recoge en el borde de la pantalla."
          }
