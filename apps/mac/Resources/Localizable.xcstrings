    "Compare it with %@ in person or on a call. If both of you see the same digits, your messages are only readable by the two of you." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνετέ τον με τον χρήστη %@ αυτοπροσώπως ή σε μια κλήση. Αν βλέπετε και οι δύο τα ίδια ψηφία, τα μηνύματά σας μπορούν να διαβαστούν μόνο από εσάς τους δύο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compáralo con %@ en persona o en una llamada. Si los dígitos coinciden, solo tú y esa persona pueden leer los mensajes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接会うか通話で、%@と照合してください。お互いに同じ数字が表示されていれば、メッセージを読めるのは2人だけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请与 %@ 当面或通话核对。如果你们看到的数字相同，你们的消息就只有你们两人可以读取。"
          }
        }
      }
    },
