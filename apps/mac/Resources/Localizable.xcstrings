    "Idle dots stay half-filled whatever their colour, so they never depend on colour alone." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κουκκίδες αδράνειας μένουν μισογεμάτες όποιο κι αν είναι το χρώμα τους, ώστε να μην εξαρτώνται ποτέ μόνο από το χρώμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos inactivos siguen medio llenos sea cual sea su color, así que nunca dependen solo del color."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイドル中のドットは色にかかわらず半分だけ塗りつぶされるため、色だけに頼ることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闲置圆点无论颜色如何都保持半实心，因此不会仅靠颜色区分。"
          }
        }
      }
    },
