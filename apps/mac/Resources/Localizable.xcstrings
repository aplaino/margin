    },
    "Friends only see the tool, the model, your token count, and the repo when it’s public. Never your code, prompts, files or branches." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φίλοι βλέπουν μόνο το εργαλείο, το μοντέλο, τον αριθμό των tokens σας και το αποθετήριο όταν είναι δημόσιο. Ποτέ τον κώδικα, τις προτροπές, τα αρχεία ή τους κλάδους σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus amigos solo ven la herramienta, el modelo, tu número de tokens y el repositorio si es público. Nunca tu código, instrucciones, archivos ni ramas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達に表示されるのは、ツール、モデル、トークン数、および公開リポジトリだけです。コード、プロンプト、ファイル、ブランチが表示されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友只能看到工具、模型、你的 token 数，以及公开的仓库。绝不会看到你的代码、提示词、文件或分支。"
          }
        }
      }
    },
