      }
    },
    "Your friends and messages will appear once it’s back. It restarts automatically." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φίλοι και τα μηνύματά σας θα εμφανιστούν μόλις επανέλθει. Επανεκκινείται αυτόματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus amigos y mensajes aparecerán cuando vuelva a funcionar. Se reinicia automáticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復帰すると友達とメッセージが表示されます。自動的に再起動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复后，你的朋友和消息会重新显示。它会自动重新启动。"
          }
        }
      }
    },
    "Your friends, keys and anything waiting on the server are deleted. Chat history on this Mac stays until you remove Margin." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φίλοι σας, τα κλειδιά σας και ό,τι περιμένει στον διακομιστή διαγράφονται. Το ιστορικό συνομιλιών σε αυτό το Mac παραμένει μέχρι να αφαιρέσετε το Margin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán tus amigos, tus claves y todo lo pendiente en el servidor. El historial de chat de este Mac se conserva hasta que elimines Margin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達、鍵、サーバ上で待機中のすべてのデータが削除されます。このMac上のチャット履歴は、Marginを削除するまで残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的朋友、密钥以及服务器上待接收的所有内容都会被删除。此 Mac 上的聊天记录会一直保留，直到你移除 Margin。"
          }
        }
      }
    },
    "Your profile" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το προφίλ σου"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil"
          }
        },
