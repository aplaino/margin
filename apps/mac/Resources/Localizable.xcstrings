    "Previews leave Margin’s encrypted store: macOS can show them on the lock screen and keeps them in Notification Center." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προεπισκοπήσεις φεύγουν από τον κρυπτογραφημένο χώρο του Margin: το macOS μπορεί να τις δείχνει στην οθόνη κλειδώματος και τις κρατά στο Κέντρο γνωστοποιήσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las previsualizaciones salen del almacén cifrado de Margin: macOS puede mostrarlas en la pantalla bloqueada y las guarda en el Centro de notificaciones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューはMarginの暗号化された保存領域の外に出ます。macOSはロック画面に表示することがあり、通知センターに残します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预览会离开 Margin 的加密存储：macOS 可能会在锁定屏幕上显示它们，并保留在通知中心里。"
          }
        }
      }
    },
