          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin 需要更新"
          }
        }
      }
    },
    "Margin only asks to read your public profile." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Margin ζητά μόνο να διαβάσει το δημόσιο προφίλ σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin solo pide leer tu perfil público."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marginが求めるのは公開プロフィールの読み取りだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
