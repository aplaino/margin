      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγραφή…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除…"
          }
        }
      }
    },
    "Deleting removes your friends, keys and anything waiting on the server. Chat history on this Mac stays until you remove Margin." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαγραφή αφαιρεί τους φίλους σας, τα κλειδιά σας και ό,τι περιμένει στον διακομιστή. Το ιστορικό συνομιλιών σε αυτό το Mac παραμένει μέχρι να αφαιρέσετε το Margin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminarla se borran tus amigos, tus claves y todo lo pendiente en el servidor. El historial de chat de este Mac se conserva hasta que elimines Margin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除すると、友達、鍵、サーバ上で待機中のすべてのデータが削除されます。このMac上のチャット履歴は、Marginを削除するまで残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除后，你的朋友、密钥以及服务器上待接收的所有内容都会被移除。此 Mac 上的聊天记录会一直保留，直到你移除 Margin。"
          }
        }
      }
    },
