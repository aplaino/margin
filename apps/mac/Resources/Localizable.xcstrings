    "It’s removed from this Mac. %@ keeps their copy." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρείται από αυτό το Mac. Ο χρήστης %@ κρατά το δικό του αντίγραφο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimina de este Mac. %@ conserva su copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacから削除されます。%@側のコピーは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会从这台 Mac 上删除。%@ 仍保留自己的副本。"
          }
        }
      }
    },
    "It’s running from outside Applications, so it can’t update itself and can’t connect your tools." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελείται εκτός του φακέλου «Εφαρμογές», οπότε δεν μπορεί να ενημερωθεί ούτε να συνδέσει τα εργαλεία σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está ejecutando fuera de Aplicaciones, así que no puede actualizarse ni conectar tus herramientas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アプリケーション」以外の場所から実行されているため、アップデートやツールの接続ができません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在“应用程序”文件夹之外运行，因此无法自行更新，也无法连接你的工具。"
          }
        }
      }
    },
