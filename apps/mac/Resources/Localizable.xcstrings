      }
    },
    "Margin quit unexpectedly" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Margin τερματίστηκε απροσδόκητα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin se cerró de forma inesperada"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marginが予期しない理由で終了しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin 意外退出"
          }
        }
