    "Margin" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin"
          }
        }
      }
    },
    "Margin adds a small hook to each tool you turn on, and backs up the file first. It never prints anything into your sessions." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Margin προσθέτει ένα μικρό hook σε κάθε εργαλείο που ενεργοποιείτε και δημιουργεί πρώτα αντίγραφο ασφαλείας του αρχείου. Δεν εμφανίζει ποτέ τίποτα στις συνεδρίες σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin añade un pequeño hook a cada herramienta que actives, tras hacer una copia de seguridad del archivo. Nunca escribe nada en tus sesiones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marginは、オンにした各ツールに小さなフックを追加します。追加する前にファイルをバックアップします。セッションに何かを出力することはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin 会为你开启的每个工具添加一个小型钩子，并先备份相关文件。它绝不会在你的会话中输出任何内容。"
          }
        }
      }
    },
    "Margin is invite-only. Add a friend by their GitHub handle; they’ll see your request in their Margin." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Margin λειτουργεί μόνο με πρόσκληση. Προσθέστε έναν φίλο με το όνομα χρήστη του στο GitHub· θα δει το αίτημά σας στο δικό του Margin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin funciona solo con invitación. Añade a un amigo por su usuario de GitHub; verá tu solicitud en su Margin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marginは招待制です。GitHubハンドルで友達を追加すると、相手のMarginにリクエストが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin 仅限邀请使用。通过 GitHub 用户名添加朋友，对方会在自己的 Margin 中看到你的请求。"
          }
        }
      }
    },
    "Margin isn’t running in the background" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Margin δεν εκτελείται στο παρασκήνιο"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin no se está ejecutando en segundo plano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marginがバックグラウンドで実行されていません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin 未在后台运行"
          }
        }
      }
    },
    "Margin needs an update" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Margin χρειάζεται ενημέρωση"
