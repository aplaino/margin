    "Hide a repo entirely, or keep it shown only as “private project”, whatever GitHub says." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποκρύψτε εντελώς ένα αποθετήριο ή εμφανίζετέ το μόνο ως «ιδιωτικό έργο», ό,τι κι αν λέει το GitHub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta un repositorio por completo o muéstralo solo como «proyecto privado», diga lo que diga GitHub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubでの設定にかかわらず、リポジトリを完全に非表示にするか、「非公開プロジェクト」としてのみ表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全隐藏某个仓库，或无论 GitHub 上如何设置，都只显示为“私人项目”。"
