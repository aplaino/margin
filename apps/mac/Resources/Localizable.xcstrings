    "They’ll get a request. If they’ve already asked you, you’re friends right away." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα λάβει ένα αίτημα. Αν σας το έχει ήδη ζητήσει, γίνεστε φίλοι αμέσως."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirá una solicitud. Si ya te había enviado una, serán amigos al instante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手にリクエストが届きます。相手からすでにリクエストが届いている場合は、すぐに友達になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方会收到一个请求。如果对方已向你发出请求，你们会立即成为朋友。"
          }
        }
      }
    },
    "This version can’t talk to the server any more." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
