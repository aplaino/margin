    "All messages with %@ are removed from this Mac. They keep their copy." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα τα μηνύματα με τον χρήστη %@ αφαιρούνται από αυτό το Mac. Ο άλλος κρατά το δικό του αντίγραφο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los mensajes con %@ se eliminan de este Mac. Esa persona conserva su copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@とのすべてのメッセージがこのMacから削除されます。相手側のコピーは残ります。"
