    "macOS notifications are off for Margin, so it uses its own alerts until you allow them." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι γνωστοποιήσεις macOS είναι απενεργοποιημένες για το Margin, οπότε χρησιμοποιεί τις δικές του ειδοποιήσεις μέχρι να τις επιτρέψετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de macOS están desactivadas para Margin, así que usa sus propios avisos hasta que las permitas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MarginのmacOSの通知はオフになっています。許可するまでMargin独自の通知を使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin 的 macOS 通知已关闭，因此在你允许之前，Margin 会使用自己的提醒。"
          }
        }
      }
